# ════════════════════════════════════════════════════════════════
#  .env.example — committed. Real values live in .env (gitignored).
#  Copy to .env locally; set the same vars in Vercel for production.
# ════════════════════════════════════════════════════════════════

# ─── Database (Neon — Vercel → Storage → Create Database) ───
# DATABASE_URL = pooled  (hostname contains "-pooler.")
# DIRECT_URL   = direct  (no "-pooler." in hostname)
DATABASE_URL=
DIRECT_URL=

# ─── Bootstrap super-admin (used once by seed; delete after first login) ───
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=

# ─── Better Auth ───
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─── Cloudinary (image / PDF uploads — cloudinary.com → Dashboard) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=bba-dept

# ─── Resend (Phase 9 — contact form email delivery) ───
# Obtain from https://resend.com → API Keys. Free tier: 100 emails/day.
# Leave blank to disable email delivery (submissions still store in
# DB; admin sees emailSentAt=null with the skip reason).
RESEND_API_KEY=
